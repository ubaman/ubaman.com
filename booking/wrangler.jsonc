{
  "name": "ubaman-booking",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "ubaman-booking", "database_id": "32a0f455-ec25-493a-988f-9c74f5775a79"}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "BOOKING_ENABLED": "false",
    "PUBLIC_ORIGIN": "https://REPLACE.workers.dev",
    "TIME_ZONE": "America/Mexico_City",
    "START_HOUR": "9",
    "END_HOUR": "17",
    "DAYS": "0,1,2,3,4,5,6",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_SITE_KEY"
  }
}
